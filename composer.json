{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.1",
        "doctrine/dbal": "^3.6",
        "felixkiss/uniquewith-validator": "^3.4",
        "fruitcake/laravel-cors": "^2.2",
        "graham-campbell/security": "^10.0",
        "guzzlehttp/guzzle": "^7.8",
        "jorijn/laravel-security-checker": "^2.6",
        "laravel/framework": "^8.5",
        "laravel/passport": "^10.4",
        "laravel/tinker": "^2.8",
        "laravel/ui": "^3.4",
        "lcobucci/jwt": "^4.3",
        "league/flysystem-aws-s3-v3": "^1.0",
        "maatwebsite/excel": "^3.1",
        "nwidart/laravel-modules": "^8.6",
        "owen-it/laravel-auditing": "^13.7",
        "paypal/rest-api-sdk-php": "^1.14",
        "php-http/message-factory": "^1.1",
        "phpoffice/phpspreadsheet": "^1.29",
        "sentry/sentry-laravel": "^4.25",
        "spatie/laravel-permission": "^4.4",
        "watson/validating": "^7.0",
        "yajra/laravel-datatables-oracle": "^9.0"
    },
    "require-dev": {
        "facade/ignition": "^2.17",
        "fakerphp/faker": "^1.23",
        "filp/whoops": "^2.15",
        "friendsofphp/php-cs-fixer": "^3.64",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^5.11",
        "nunomaduro/larastan": "^1.0",
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "lint-codes": [
            "php-cs-fixer fix app",
            "php-cs-fixer fix config",
            "php-cs-fixer fix database",
            "php-cs-fixer fix resources",
            "php-cs-fixer fix routes",
            "php-cs-fixer fix tests"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "audit": {
        "abandoned": "ignore",
        "ignore": [
            "PKSA-z3gr-8qht-p93v",
            "PKSA-y2cr-5h3j-g3ys",
            "PKSA-2kqm-ps5x-s4f5"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
